#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESCAPE        &kp Q     &kp W     &kp E        &kp R        &kp T                 &kp Y        &kp U  &kp I      &kp O    &kp P      &kp BACKSPACE
&kp TAB           &kp A     &kp S     &kp D        &kp F        &kp G                 &kp H        &kp J  &kp K      &kp L    &kp SEMI   &kp SQT
&sk LEFT_SHIFT    &kp Z     &kp X     &kp C        &kp V        &kp B                 &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH  &sk RIGHT_SHIFT
&kp LEFT_CONTROL  &kp LALT  &kp LGUI  &lt 1 SPACE  &lt 5 SPACE             &kp ENTER  &lt 2 ENTER                                        &kp RIGHT_COMMAND
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&none           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp BACKSPACE
&none           &kp CAPSLOCK  &none         &kp UP        &none         &kp PAGE_UP                   &kp PAGE_UP    &none         &kp UP        &none         &none         &none
&kp LEFT_SHIFT  &none         &kp LEFT      &kp DOWN      &kp RIGHT     &kp PAGE_DOWN                 &kp PAGE_DOWN  &kp LEFT      &kp DOWN      &kp RIGHT     &none         &none
&trans          &trans        &trans        &trans        &kp SPACE                        &kp ENTER  &trans                                                                 &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&none       &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                 &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)      &kp LS(NUMBER_8)       &kp LS(NUMBER_9)      &kp RA(BACKSPACE)
&none       &none             &kp C_PREVIOUS    &kp C_PLAY        &kp C_NEXT        &trans                           &kp MINUS         &kp EQUAL         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SQT               &none
&kp LSHIFT  &kp LA(NUMBER_5)  &kp LA(NUMBER_6)  &kp LA(NUMBER_8)  &kp LA(NUMBER_9)  &trans                           &kp LS(MINUS)     &kp PLUS          &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp NON_US_BACKSLASH  &none
&trans      &trans            &trans            &trans            &kp SPACE                               &kp ENTER  &trans                                                                                                 &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&bt BT_CLR  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp F4  &none              &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none   &none              &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none   &none              &none  &none  &none  &none  &none  &none
&trans      &trans        &trans        &trans        &trans             &trans  &mo 3                              &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none   &kp N1          &kp N2          &kp N3        &kp N4     &kp N5              &kp N6         &kp N7     &kp N8     &kp N9     &kp N0  &none
&none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none               &kp PAGE_UP    &mkp LCLK  &mkp MCLK  &mkp RCLK  &none   &none
&none   &none           &none           &none         &none      &none               &kp PAGE_DOWN  &none      &none      &none      &none   &none
&trans  &trans          &trans          &trans        &trans                 &trans  &trans                                                  &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;
        };
    };
};
